  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "server.json"
  ],
  "homepage": "https://github.com/CloudCorpRecords/asinlens#readme",
  "license": "MIT",
  "mcpName": "io.github.CloudCorpRecords/asinlens",
  "name": "@reneturcios/asinlens",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CloudCorpRecords/asinlens.git"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts"
  },
